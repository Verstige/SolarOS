{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "startCommand": "npm run start"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "env": {
    "PORT": "3002",
    "NODE_ENV": "production"
  },
  "healthcheck": {
    "path": "/",
    "port": 3002
  }
}